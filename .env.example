# ============================================================
#  JACOBO-BOT — Configuración
#  Copia este archivo como .env y rellena los valores
#  cp .env.example .env
# ============================================================


# ------------------------------------------------------------
# PROXY RESIDENCIAL — Evita bloqueos de IP en Idealista
# Sin proxy: el scraper usa tu IP real (puede bloquearse)
# Con proxy: las peticiones salen desde IPs residenciales rotadas
#
# Servicios recomendados:
#   Smartproxy  → https://smartproxy.com  (~$15/mes, prueba gratis 3 días)
#   BrightData  → https://brightdata.com  (~$15/mes)
#
# Deja en blanco para no usar proxy (útil para pruebas locales)
# ------------------------------------------------------------
PROXY_SERVER=
PROXY_USER=
PROXY_PASSWORD=


# ------------------------------------------------------------
# IDEALISTA — Perfiles de agencias a monitorear
# Para añadir más perfiles, separa las URLs con comas (sin espacios)
# ------------------------------------------------------------
IDEALISTA_PROFILE_URLS=https://www.idealista.com/pro/inmobiliariavasanco/,https://www.idealista.com/pro/raulgalisteo/


# ------------------------------------------------------------
# KIE.AI — Procesamiento de fotos (quitar marca de agua + mejorar)
# Obtén tu API key en: https://kie.ai/api-key
# ------------------------------------------------------------
KIE_AI_API_KEY=a4953f8c6d8ac3b8eb3422ced23faa0c

# Máx. fotos normales a descargar y mejorar por propiedad (los planos siempre se incluyen aparte)
# Rango recomendado: 10-20  |  Cada foto procesada por Kie.ai cuesta ~0.027 USD
# Para pruebas rápidas: usar 2-3
MAX_PHOTOS_PER_PROPERTY=15

# Home staging virtual con KIE.AI (añade muebles a habitaciones vacías)
# Activar solo cuando quieras pagar el extra — por defecto: false
ENABLE_HOME_STAGING=false

# Máx. propiedades a scrapear por colaborador/agencia (0 = sin límite)
# Para pruebas rápidas: usar 2-5
MAX_PROPERTIES_PER_AGENCY=0


# ------------------------------------------------------------
# WORDPRESS — Credenciales
# WP_APP_PASSWORD: generar en WP > Usuarios > Tu Perfil > Application Passwords
#   (es diferente a la contraseña normal de login)
# ------------------------------------------------------------
WP_URL=https://lightblue-turtle-601986.hostingersite.com
WP_USER=LeadsforaLL@gmail.com
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Tipo de post en WordPress (Houzez usa "property")
WP_PROPERTY_POST_TYPE=property
# Endpoint REST de WordPress para propiedades (Houzez usa "properties")
WP_PROPERTY_REST_BASE=properties


# ------------------------------------------------------------
# BASE DE DATOS (SQLite local)
# ------------------------------------------------------------
DB_PATH=data/jacobo_bot.db


# ------------------------------------------------------------
# EMAIL / SMTP — Para enviar búsquedas de compradores a agencias colaboradoras
# Si usas Hostinger, los datos SMTP están en tu panel de hosting
# ------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=tu_correo@tudominio.com
SMTP_PASSWORD=tu_contraseña_smtp
EMAIL_FROM=tu_correo@tudominio.com
EMAIL_FROM_NAME=Nombre de tu Agencia Inmobiliaria


# ------------------------------------------------------------
# AGENCIAS COLABORADORAS
# JSON array — añade tantas como quieras
# Campos: name (texto), email (email), zones (array de zonas que cubren)
# ------------------------------------------------------------
COLLABORATING_AGENCIES=[{"name":"Inmobiliaria Vasanco","email":"info@vasanco.com","zones":["Málaga","Marbella"]},{"name":"Raúl Galisteo Inmobiliaria","email":"info@raulgalisteo.com","zones":["Málaga","Fuengirola"]}]


# ------------------------------------------------------------
# MARCAS DE COMPETIDORES — Se eliminan automáticamente del texto
# Separadas por comas, sin espacios
# ------------------------------------------------------------
COMPETITOR_BRANDS=Vasanco,OtraInmobiliaria


# ------------------------------------------------------------
# SCHEDULER — Horario de ejecución diaria
# SCRAPE_HOUR: hora del día (0-23) en que se ejecuta el scraper. Por defecto: 3 (3am)
# SCRAPE_MINUTE: minuto de la hora. Por defecto: 0
# ------------------------------------------------------------
SCRAPE_HOUR=3
SCRAPE_MINUTE=0

# ------------------------------------------------------------
# SCRAPER — Delays entre requests (segundos)
# Valores más altos = menos detectable, más lento
# Recomendado: min 25, max 55 — ajustar solo si hay bloqueos frecuentes
# ------------------------------------------------------------
SCRAPE_DELAY_MIN=25
SCRAPE_DELAY_MAX=55


# ------------------------------------------------------------
# SCRAPE.DO — Fallback anti-bloqueo para DataDome (proxies residenciales)
# Opcional: si se configura, se usa automáticamente cuando el scraper normal falla
# Obtén tu token en: https://scrape.do
# ------------------------------------------------------------
SCRAPE_DO_TOKEN=

# ------------------------------------------------------------
# CLAUDE AI — Para búsqueda inteligente en lenguaje natural
# Opcional: si no se configura, el sistema usa regex básico
# Obtén tu API key en: https://console.anthropic.com
# ------------------------------------------------------------
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# FLASK API — API interna que conecta el formulario de la web con el bot
# FLASK_PORT: puerto donde corre la API (debe estar abierto en el firewall)
# FLASK_SECRET: clave secreta para proteger los endpoints
#   (debe coincidir con lo que pongas en el plugin de WordPress)
# DASHBOARD_PASSWORD: contraseña para acceder al dashboard web
# ------------------------------------------------------------
FLASK_PORT=8080
FLASK_SECRET=cambia_esto_por_una_clave_segura_generada
DASHBOARD_PASSWORD=dashboard_password_aqui
